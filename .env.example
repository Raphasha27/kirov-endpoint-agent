# Endpoint Agent Configuration
KIROV_CORE_URL=http://localhost:8000
KIROV_AGENT_ID=
KIROV_LOG_LEVEL=info
KIROV_HEARTBEAT_INTERVAL=60
KIROV_WATCH_DIRS=/etc,/usr/local/bin,/opt
KIROV_ALLOWED_PROCESSES=systemd,sshd,nginx,postgres,redis-server,dockerd,python3,node,go
KIROV_BLACKLIST_PROCESSES=mimikatz,powershell -enc,nc,ncat,cryptominer
